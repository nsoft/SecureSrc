<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.needhamsoftware.securesrc.ui.EncryptionUpdatePanel">
  <grid id="27dc6" binding="layoutPanel" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="944" height="1031"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="71f0a" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <horizontalAlignment value="0"/>
          <maximumSize width="2147483647" height="350"/>
          <preferredSize width="500" height="300"/>
          <text value="&lt;html&gt;You can enter a cipher specification below. If Java supports it the program will try to use it. If you get errors, STOP and set it to the default value of AES/GCM/NoPadding &lt;br&gt; &lt;br&gt;The program makes 9 back up copies automatically, but if you edit 9 times that will cause 9 saves. In the case where Java can write with the new cipher but not read the data, all passwords would be lost. Such a thing can happen if the new cipher has additional or different input vector requirements. If the default implementation uses a random value when writing and the value used is not preserved (because the current code knows nothing about it), reading what was written may be impossible. The good news is that the save format includes the details on which cipher to use when reading so even if you changed this default, it will be ingored for reading an old backup&lt;br&gt;&lt;br&gt; This feature is for expert use only, and experts should make a separate backup in a different location. If you don't know what a cipher specification is, don't touch this.&lt;/html&gt;"/>
        </properties>
      </component>
      <vspacer id="9c09f">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
      </vspacer>
      <component id="389c3" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="New Cipher to Try:"/>
        </properties>
      </component>
      <component id="ef463" class="javax.swing.JTextField" binding="cipherSpec" default-binding="true">
        <constraints>
          <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties/>
      </component>
      <hspacer id="c290d">
        <constraints>
          <grid row="1" column="4" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
      </hspacer>
      <hspacer id="a22e9">
        <constraints>
          <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
      </hspacer>
      <vspacer id="74853">
        <constraints>
          <grid row="4" column="4" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
